{
	"name": "arenarium-maps-demo-cityexpert",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"cf_typegen": "wrangler types ./src/worker-configuration.d.ts",
		"cf_preview": "pnpm run build && wrangler dev",
		"cf_deploy": "pnpm run build && wrangler deploy --outdir .wrangler/outdir"
	},
	"devDependencies": {
		"@fontsource-variable/montserrat": "^5.3.0",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.39.0",
		"@sveltejs/adapter-auto": "latest",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "latest",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"embla-carousel-svelte": "^8.6.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"shadcn-svelte": "^1.5.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^7.3.6"
	},
	"dependencies": {
		"@arenarium/maps": "1.5.19",
		"@arenarium/maps-integration-maplibre": "^1.0.36",
		"wrangler": "^4.127.1"
	}
}
